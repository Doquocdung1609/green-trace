generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  region    String
  createdAt DateTime @default(now())
  users     User[]
  assets    Asset[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  phone          String?
  role           String
  organizationId String?
  solanaWallet   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization  Organization? @relation(fields: [organizationId], references: [id])
  assets         Asset[] @relation("AssetCustodian")
  evidence       Evidence[] @relation("EvidenceSubmitter")
  requestedVerifications VerificationRequest[] @relation("RequestCreator")
  assignedVerifications VerificationRequest[] @relation("RequestedVerifier")
  attestations   Attestation[]
  audits         AuditLog[]
}

model Asset {
  id               String   @id @default(cuid())
  assetCode        String   @unique
  displayName      String
  assetType        String
  species          String
  custodianId      String
  organizationId   String
  description      String
  region           String
  exactLatitude    Float
  exactLongitude   Float
  plantedAt        DateTime
  currentStage     String   @default("REGISTERED")
  passportStatus   String   @default("NOT_READY")
  photoUrl         String?
  metadataHash     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  custodian        User @relation("AssetCustodian", fields: [custodianId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id])
  evidence         Evidence[]
  verificationRequests VerificationRequest[]
  attestations     Attestation[]
  lifecycleEvents  LifecycleEvent[]
  trustProfile     TrustProfile?
  passports        DigitalPassport[]
  blockchainTransactions BlockchainTransaction[]
}

model Evidence {
  id                 String   @id @default(cuid())
  assetId            String
  type               String
  title              String
  description        String?
  source             String
  observedAt         DateTime
  submittedAt        DateTime @default(now())
  submittedBy        String
  storageUri         String
  mimeType           String
  contentHash        String
  visibility         String   @default("PRIVATE")
  validFrom          DateTime?
  validUntil         DateTime?
  verificationStatus String   @default("PENDING")
  metadataJson       String?
  asset              Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  submittedByUser    User @relation("EvidenceSubmitter", fields: [submittedBy], references: [id])
  verificationRequests VerificationRequest[]
  attestations       Attestation[]
  @@index([assetId, contentHash])
}

model VerificationRequest {
  id                  String   @id @default(cuid())
  assetId             String
  evidenceId          String
  requestedScope      String
  requestedVerifierId String?
  requesterId         String
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  resolvedAt          DateTime?
  asset               Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  evidence            Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  requestedVerifier   User? @relation("RequestedVerifier", fields: [requestedVerifierId], references: [id])
  requester           User @relation("RequestCreator", fields: [requesterId], references: [id])
  @@index([status, requestedVerifierId])
}

model Attestation {
  id             String   @id @default(cuid())
  evidenceId     String
  assetId        String
  verifierId     String
  verifierWallet String
  scope          String
  decision       String
  note           String
  payloadHash    String
  txSignature    String?
  chainStatus    String   @default("PENDING_CHAIN")
  verifiedAt     DateTime @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  evidence       Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  asset          Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  verifier       User @relation(fields: [verifierId], references: [id])
  @@index([assetId, decision])
}

model LifecycleEvent {
  id           String   @id @default(cuid())
  assetId      String
  stageFrom    String
  stageTo      String
  eventType    String
  evidenceIds  String
  approvedBy   String
  txSignature  String?
  occurredAt   DateTime @default(now())
  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model TrustProfile {
  id                String   @id @default(cuid())
  assetId           String   @unique
  identityScore     Int
  evidenceScore     Int
  verificationScore Int
  freshnessScore    Int
  consistencyScore  Int
  totalScore        Int
  warningCount      Int
  warningsJson      String
  calculatedAt      DateTime @default(now())
  asset             Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model DigitalPassport {
  id              String   @id @default(cuid())
  assetId         String
  version         Int
  passportHash    String
  readinessStatus String
  generatedAt     DateTime @default(now())
  asset           Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([assetId, version])
}

model BlockchainTransaction {
  id        String   @id @default(cuid())
  assetId   String
  type      String
  signature String   @unique
  cluster   String
  signer    String
  status    String
  createdAt DateTime @default(now())
  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  user       User? @relation(fields: [userId], references: [id])
}

