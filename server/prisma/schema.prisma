generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String             @id @default(cuid())
  name             String             @unique
  type             String
  region           String
  verifierCategory String?
  createdAt        DateTime           @default(now())
  users            User[]
  assets           Asset[]
  rightsRecords    RightsRecord[]     @relation("RightsHolderOrganization")
  custodyRecords   CustodyRecord[]    @relation("CustodianOrganization")
  careAgreements   CareAgreement[]    @relation("CaretakerOrganization")
  offers           AssetOffer[]       @relation("SellerOrganization")
  transactionsSold AssetTransaction[] @relation("TransactionSellerOrganization")
  valuations       AssetValuation[]   @relation("ValuatorOrganization")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  fullName               String
  phone                  String?
  role                   String
  permissionsJson        String                  @default("[]")
  organizationId         String?
  solanaWallet           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization?           @relation(fields: [organizationId], references: [id])
  assets                 Asset[]                 @relation("AssetCustodian")
  evidence               Evidence[]              @relation("EvidenceSubmitter")
  requestedVerifications VerificationRequest[]   @relation("RequestCreator")
  assignedVerifications  VerificationRequest[]   @relation("RequestedVerifier")
  attestations           Attestation[]
  measurements           BiologicalMeasurement[] @relation("MeasurementReporter")
  incidents              AssetIncident[]         @relation("IncidentReporter")
  transactionsBought     AssetTransaction[]      @relation("TransactionBuyer")
  reservedOffers         AssetOffer[]            @relation("ReservedBuyer")
  reviewCasesRequested   ReviewCase[]            @relation("ReviewRequester")
  reviewCasesAssigned    ReviewCase[]            @relation("ReviewAssignee")
  fulfillmentRequests    FulfillmentRequest[]    @relation("FulfillmentRequester")
  audits                 AuditLog[]
}

model AssetTemplate {
  id                         String               @id @default(cuid())
  key                        String               @unique
  name                       String
  version                    Int                  @default(1)
  assetType                  String
  prefix                     String               @default("GN")
  active                     Boolean              @default(true)
  requiredIdentityFieldsJson String
  optionalFieldsJson         String
  requiredEvidenceJson       String
  importantEvidenceJson      String
  lifecycleRulesJson         String
  riskRulesJson              String
  readinessRulesJson         String
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  assets                     Asset[]
  verificationProfile        VerificationProfile?
}

model VerificationProfile {
  id             String        @id @default(cuid())
  templateId     String        @unique
  name           String
  description    String
  policyKeysJson String
  createdAt      DateTime      @default(now())
  template       AssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model VerificationPolicy {
  id                              String                @id @default(cuid())
  key                             String                @unique
  evidenceType                    String                @unique
  verificationRequired            Boolean
  requiredScope                   String?
  requiredVerifierCategory        String?
  independentOrganizationRequired Boolean               @default(false)
  expiresAfterDays                Int?
  affectsReadiness                Boolean               @default(false)
  affectsLifecycle                Boolean               @default(false)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  evidence                        Evidence[]
  requests                        VerificationRequest[]
}

model Asset {
  id                     String                  @id @default(cuid())
  assetCode              String                  @unique
  displayName            String
  assetType              String
  assetLevel             String                  @default("LOT")
  species                String
  scientificName         String?
  cultivar               String?
  propagationSource      String?
  propagationBatchCode   String?
  formationMethod        String?
  plantedAt              DateTime
  plantedAtConfidence    String                  @default("DECLARED")
  ageBasis               String                  @default("DECLARED")
  initialQuantity        Float?
  quantityUnit           String?
  areaHectares           Float?
  density                Float?
  custodianId            String
  organizationId         String
  caretaker              String?
  managementBasis        String?
  description            String
  region                 String
  province               String?
  district               String?
  commune                String?
  exactLatitude          Float
  exactLongitude         Float
  elevationMeters        Float?
  spatialType            String                  @default("POINT")
  boundaryGeoJson        String?
  growingAreaCode        String?
  geographicalIndication String?
  templateId             String?
  currentStage           String                  @default("REGISTERED")
  transactionStage       String                  @default("NOT_LISTED")
  passportStatus         String                  @default("NOT_READY")
  photoUrl               String?
  metadataHash           String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  custodian              User                    @relation("AssetCustodian", fields: [custodianId], references: [id])
  organization           Organization            @relation(fields: [organizationId], references: [id])
  template               AssetTemplate?          @relation(fields: [templateId], references: [id])
  evidence               Evidence[]
  verificationRequests   VerificationRequest[]
  attestations           Attestation[]
  lifecycleEvents        LifecycleEvent[]
  trustProfile           TrustProfile?
  riskProfile            RiskProfile?
  readinessProfiles      ReadinessProfile[]
  passports              DigitalPassport[]
  blockchainTransactions BlockchainTransaction[]
  measurements           BiologicalMeasurement[]
  incidents              AssetIncident[]
  rightsRecords          RightsRecord[]
  custodyRecords         CustodyRecord[]
  careAgreements         CareAgreement[]
  offers                 AssetOffer[]
  transactions           AssetTransaction[]
  reviewCases            ReviewCase[]
  fulfillmentRequests    FulfillmentRequest[]
  valuations             AssetValuation[]
}

model Evidence {
  id                     String                  @id @default(cuid())
  assetId                String
  type                   String
  title                  String
  description            String?
  source                 String
  sourceType             String                  @default("DECLARED")
  observedAt             DateTime
  submittedAt            DateTime                @default(now())
  submittedBy            String
  storageUri             String
  mimeType               String
  contentHash            String
  visibility             String                  @default("PRIVATE")
  validFrom              DateTime?
  validUntil             DateTime?
  verificationStatus     String                  @default("PENDING")
  systemValidationStatus String                  @default("PASSED")
  verificationPolicyKey  String?
  metadataJson           String?
  asset                  Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  submittedByUser        User                    @relation("EvidenceSubmitter", fields: [submittedBy], references: [id])
  verificationPolicy     VerificationPolicy?     @relation(fields: [verificationPolicyKey], references: [key])
  verificationRequests   VerificationRequest[]
  attestations           Attestation[]
  measurements           BiologicalMeasurement[]
  rightsRecords          RightsRecord[]
  custodyDocuments       CustodyRecord[]
  careAgreementDocuments CareAgreement[]
  transactionDocuments   AssetTransaction[]
  valuationDocuments     AssetValuation[]
  incidentResolutions    AssetIncident[]         @relation("IncidentResolutionEvidence")

  @@index([assetId, contentHash])
  @@index([type, verificationStatus])
}

model VerificationRequest {
  id                       String              @id @default(cuid())
  assetId                  String
  evidenceId               String
  policyId                 String?
  requestedScope           String
  requiredVerifierCategory String?
  requestedVerifierId      String?
  requesterId              String
  priority                 String              @default("NORMAL")
  status                   String              @default("PENDING")
  createdAt                DateTime            @default(now())
  resolvedAt               DateTime?
  asset                    Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  evidence                 Evidence            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  policy                   VerificationPolicy? @relation(fields: [policyId], references: [id])
  requestedVerifier        User?               @relation("RequestedVerifier", fields: [requestedVerifierId], references: [id])
  requester                User                @relation("RequestCreator", fields: [requesterId], references: [id])

  @@index([status, requestedVerifierId])
  @@index([requiredVerifierCategory, status])
}

model Attestation {
  id             String    @id @default(cuid())
  evidenceId     String
  assetId        String
  verifierId     String
  verifierWallet String
  scope          String
  decision       String
  note           String
  payloadHash    String
  txSignature    String?
  chainStatus    String    @default("PENDING_CHAIN")
  verifiedAt     DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  evidence       Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  verifier       User      @relation(fields: [verifierId], references: [id])

  @@index([assetId, decision])
}

model LifecycleEvent {
  id          String   @id @default(cuid())
  assetId     String
  stageFrom   String
  stageTo     String
  eventType   String
  evidenceIds String
  approvedBy  String
  txSignature String?
  occurredAt  DateTime @default(now())
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model BiologicalMeasurement {
  id                 String    @id @default(cuid())
  assetId            String
  measurementType    String
  value              String
  unit               String
  observedAt         DateTime
  sourceEvidenceId   String?
  reportedById       String
  verificationStatus String    @default("NOT_REQUIRED")
  createdAt          DateTime  @default(now())
  asset              Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sourceEvidence     Evidence? @relation(fields: [sourceEvidenceId], references: [id])
  reportedBy         User      @relation("MeasurementReporter", fields: [reportedById], references: [id])

  @@index([assetId, measurementType, observedAt])
}

model AssetIncident {
  id                   String    @id @default(cuid())
  assetId              String
  type                 String
  severity             String
  detectedAt           DateTime
  reportedById         String
  description          String
  evidenceIds          String    @default("[]")
  verificationStatus   String    @default("NOT_REQUIRED")
  status               String    @default("OPEN")
  resolvedAt           DateTime?
  resolutionNote       String?
  resolutionEvidenceId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  asset                Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reportedBy           User      @relation("IncidentReporter", fields: [reportedById], references: [id])
  resolutionEvidence   Evidence? @relation("IncidentResolutionEvidence", fields: [resolutionEvidenceId], references: [id])

  @@index([assetId, status, severity])
}

model TrustProfile {
  id                String   @id @default(cuid())
  assetId           String   @unique
  identityScore     Int
  evidenceScore     Int
  verificationScore Int
  freshnessScore    Int
  consistencyScore  Int
  totalScore        Int
  warningCount      Int
  warningsJson      String
  calculatedAt      DateTime @default(now())
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model RiskProfile {
  id                String   @id @default(cuid())
  assetId           String   @unique
  overallRisk       String
  biologicalRisk    String
  diseaseRisk       String
  locationRisk      String
  freshnessRisk     String
  certificateRisk   String
  custodyRisk       String
  weatherRisk       String
  operationalRisk   String
  openIncidentCount Int      @default(0)
  reasonsJson       String   @default("[]")
  calculatedAt      DateTime @default(now())
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model RightsRecord {
  id                      String        @id @default(cuid())
  assetId                 String
  rightType               String
  holder                  String
  holderOrganizationId    String?
  basisDocumentEvidenceId String?
  validFrom               DateTime
  validUntil              DateTime?
  verifiedStatus          String        @default("PENDING")
  createdAt               DateTime      @default(now())
  asset                   Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  holderOrganization      Organization? @relation("RightsHolderOrganization", fields: [holderOrganizationId], references: [id])
  basisDocumentEvidence   Evidence?     @relation(fields: [basisDocumentEvidenceId], references: [id])

  @@index([assetId, verifiedStatus])
}

model CareAgreement {
  id                      String          @id @default(cuid())
  assetId                 String
  caretakerOrganizationId String
  serviceTerms            String
  careFee                 Decimal?
  currency                String          @default("VND")
  careFrequency           String
  responsibility          String
  riskAllocationSummary   String
  documentEvidenceId      String?
  status                  String          @default("ACTIVE")
  startsAt                DateTime
  endsAt                  DateTime?
  createdAt               DateTime        @default(now())
  asset                   Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  caretakerOrganization   Organization    @relation("CaretakerOrganization", fields: [caretakerOrganizationId], references: [id])
  documentEvidence        Evidence?       @relation(fields: [documentEvidenceId], references: [id])
  custodyRecords          CustodyRecord[]
}

model CustodyRecord {
  id                      String         @id @default(cuid())
  assetId                 String
  physicalCustodian       String
  custodianOrganizationId String?
  location                String
  startAt                 DateTime
  endAt                   DateTime?
  careAgreementId         String?
  status                  String         @default("ACTIVE")
  documentEvidenceId      String?
  createdAt               DateTime       @default(now())
  asset                   Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  custodianOrganization   Organization?  @relation("CustodianOrganization", fields: [custodianOrganizationId], references: [id])
  careAgreement           CareAgreement? @relation(fields: [careAgreementId], references: [id])
  documentEvidence        Evidence?      @relation(fields: [documentEvidenceId], references: [id])

  @@index([assetId, status])
}

model AssetOffer {
  id                     String             @id @default(cuid())
  assetId                String
  saleMode               String             @default("OUTRIGHT_PURCHASE")
  askingPrice            Decimal
  currency               String             @default("VND")
  sellerOrganizationId   String
  careAfterSaleAvailable Boolean            @default(false)
  careTermsSummary       String?
  status                 String             @default("AVAILABLE")
  reservedBuyerId        String?
  reservedAt             DateTime?
  expiresAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  asset                  Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sellerOrganization     Organization       @relation("SellerOrganization", fields: [sellerOrganizationId], references: [id])
  transactions           AssetTransaction[]
  reservedBuyer          User?              @relation("ReservedBuyer", fields: [reservedBuyerId], references: [id])

  @@index([status, createdAt])
}

model AssetTransaction {
  id                       String       @id @default(cuid())
  assetId                  String
  offerId                  String?
  buyerId                  String
  sellerOrganizationId     String
  price                    Decimal
  currency                 String       @default("VND")
  transactionAt            DateTime     @default(now())
  rightsDocumentEvidenceId String?
  custodyAfterSale         String
  status                   String       @default("PURCHASE_REQUESTED")
  notes                    String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  asset                    Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  offer                    AssetOffer?  @relation(fields: [offerId], references: [id])
  buyer                    User         @relation("TransactionBuyer", fields: [buyerId], references: [id])
  sellerOrganization       Organization @relation("TransactionSellerOrganization", fields: [sellerOrganizationId], references: [id])
  rightsDocumentEvidence   Evidence?    @relation(fields: [rightsDocumentEvidenceId], references: [id])

  @@index([buyerId, status])
  @@index([assetId, transactionAt])
}

model ReviewCase {
  id              String    @id @default(cuid())
  purpose         String
  assetId         String
  requestedById   String
  status          String    @default("PENDING")
  reviewerId      String?
  claimedAt       DateTime?
  summarySnapshot String
  decision        String?
  notes           String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedBy     User      @relation("ReviewRequester", fields: [requestedById], references: [id])
  reviewer        User?     @relation("ReviewAssignee", fields: [reviewerId], references: [id])

  @@index([status, purpose])
}

model ReadinessProfile {
  id               String   @id @default(cuid())
  assetId          String
  purpose          String
  status           String
  requirementsJson String
  missingItemsJson String
  calculatedAt     DateTime @default(now())
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, purpose])
}

model FulfillmentRequest {
  id            String    @id @default(cuid())
  assetId       String
  requestedById String
  type          String
  status        String    @default("REQUESTED")
  requestedAt   DateTime  @default(now())
  scheduledAt   DateTime?
  completedAt   DateTime?
  notes         String?
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedBy   User      @relation("FulfillmentRequester", fields: [requestedById], references: [id])

  @@index([assetId, status])
}

model AssetValuation {
  id                     String        @id @default(cuid())
  assetId                String
  referenceValue         Decimal
  currency               String        @default("VND")
  valuationSource        String
  valuationMethod        String
  valuedAt               DateTime
  valuatorOrganizationId String?
  supportingEvidenceId   String?
  verificationStatus     String        @default("PENDING")
  createdAt              DateTime      @default(now())
  asset                  Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  valuatorOrganization   Organization? @relation("ValuatorOrganization", fields: [valuatorOrganizationId], references: [id])
  supportingEvidence     Evidence?     @relation(fields: [supportingEvidenceId], references: [id])
}

model DigitalPassport {
  id              String   @id @default(cuid())
  assetId         String
  version         Int
  passportHash    String
  readinessStatus String
  generatedAt     DateTime @default(now())
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
}

model BlockchainTransaction {
  id        String   @id @default(cuid())
  assetId   String
  type      String
  signature String   @unique
  cluster   String
  signer    String
  status    String
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}
